# ---------------------------------------------------------------------------
# Shared by docker-compose.yml (local Postgres/Hasura/Auth stack) and by
# hasura/config.yaml. Copy this file to `.env` and fill in real values.
# ---------------------------------------------------------------------------

POSTGRES_PASSWORD=postgres

# Any long random string. Required by graphql-engine, hasura-auth and the CLI.
HASURA_GRAPHQL_ADMIN_SECRET=devsecret

# HS256 signing key shared by graphql-engine and hasura-auth - must be
# identical on both, at least 32 characters.
HASURA_GRAPHQL_JWT_SECRET_KEY=development-only-jwt-secret-key-please-change-32chars

# Shared secrets between Hasura and the backend (Actions + Event Triggers),
# so the backend can reject requests that didn't actually come from Hasura.
HASURA_ACTION_SECRET=devsecret-action
HASURA_EVENT_SECRET=devsecret-event

FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# backend/ (Node/TS Actions + workflow engine + webhooks) - see backend/src/env.ts
# ---------------------------------------------------------------------------

PORT=4001
DATABASE_URL=postgres://postgres:postgres@localhost:55432/postgres
HASURA_GRAPHQL_URL=http://localhost:8081/v1/graphql
AUTH_URL=http://localhost:4000

# LLM provider for the llm_call step (spec section 2/17.1). Groq has a free
# tier and an OpenAI-compatible API. Leave LLM_API_KEY empty to fall back to
# a clearly-disclosed stub response instead of a real API call.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant

# Used by the notify step's event-triggered delivery (backend/src/webhooks/notifyEvent.ts)
# to email the organization owner. Defaults match the local Mailhog container in
# docker-compose.yml (web UI at http://localhost:8025, no auth needed) so notify
# steps work out of the box in dev. Point these at a real SMTP provider (Gmail,
# SendGrid, etc.) in production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AI Agent Workflow Builder <notifications@ai-workflow-builder.local>

# ---------------------------------------------------------------------------
# frontend/ (Next.js) - NEXT_PUBLIC_* vars are baked into the client bundle.
# For a real Nhost cloud project, set NEXT_PUBLIC_NHOST_SUBDOMAIN/REGION
# instead of the individual service URLs below.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_NHOST_SUBDOMAIN=
NEXT_PUBLIC_NHOST_REGION=

NEXT_PUBLIC_NHOST_AUTH_URL=http://localhost:4000/v1
NEXT_PUBLIC_NHOST_GRAPHQL_URL=http://localhost:8081/v1/graphql
NEXT_PUBLIC_NHOST_STORAGE_URL=http://localhost:8000/v1

NEXT_PUBLIC_BACKEND_URL=http://localhost:4001
